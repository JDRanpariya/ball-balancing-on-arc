<button
  id="theme-toggle"
  type="button"
  aria-label="Switch to dark mode"
  class="p-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] hover:bg-[var(--color-surface-alt)] transition-colors cursor-pointer"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg
    class="w-4 h-4 hidden dark:block text-[var(--color-accent)]"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg
    class="w-4 h-4 block dark:hidden text-[var(--color-text-primary)]"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    // Set initial label based on current state
    var isDark = document.documentElement.classList.contains('dark');
    btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');

    btn.addEventListener('click', function () {
      var nowDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', nowDark ? 'dark' : 'light');
      btn.setAttribute('aria-label', nowDark ? 'Switch to light mode' : 'Switch to dark mode');
    });
  })();
</script>
