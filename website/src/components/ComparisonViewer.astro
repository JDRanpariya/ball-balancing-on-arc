---
// ComparisonViewer: 3D trajectory replay with Real vs Sim split viewport
---

<section id="controllers" class="section border-t border-[var(--color-border)]">
  <div class="container max-w-[90rem]">
    <span class="section-eyebrow reveal">Controllers</span>
    <h2 class="reveal section-title text-center mb-3">13 Controllers Compared</h2>
    <p class="reveal text-center text-[var(--color-text-secondary)] text-sm max-w-xl mx-auto mb-10">
      5 classical + 5 learning-based + 3 data-driven controllers evaluated under identical conditions on real hardware: 50 stratified trials each.
    </p>

    <!-- Category selector -->
    <div class="flex flex-wrap justify-center gap-3 mb-10" id="cat-selector">
      <button data-cat="fast_settle" class="cat-btn active">Fast Settle</button>
      <button data-cat="recovery" class="cat-btn">Recovery</button>
      <button data-cat="failure" class="cat-btn">Failure</button>
    </div>

    <!-- Main layout: left tabs | 3D viewer | right tabs -->
    <div class="flex flex-col md:flex-row items-stretch gap-5 w-full">
      <!-- Classical controllers (left) -->
      <div class="flex flex-row flex-wrap md:flex-col md:flex-nowrap justify-center gap-2 min-w-[100px]" id="tabs-left">
        <span class="w-full text-[9px] uppercase tracking-[0.15em] font-bold text-[var(--color-text-muted)] text-center mb-3 border-b border-[var(--color-border)] pb-2">Classical</span>
        <button data-ctrl="PID" class="ctrl-tab active relative">PD<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">50µs</span></button>
        <button data-ctrl="LQR" class="ctrl-tab relative">LQR<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">0.33ms</span></button>
        <button data-ctrl="SMC" class="ctrl-tab relative">SMC<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">60µs</span></button>
        <button data-ctrl="MPC" class="ctrl-tab relative">MPC<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">0.47ms</span></button>
        <button data-ctrl="NMPC" class="ctrl-tab relative">NMPC<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded">5.1ms</span></button>
      </div>

      <!-- 3D Viewer -->
      <div class="flex-none w-full md:flex-1 md:w-auto relative" id="viewer-wrap">
        <div class="relative w-full aspect-[16/9] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg overflow-hidden" id="viewer-3d">
          <!-- Video layer (full width, no split for now) -->
          <video id="replay-video" class="absolute inset-0 w-full h-full object-cover cursor-pointer" muted playsinline loop autoplay></video>
          <!-- Play/pause overlay button -->
          <button id="play-pause-btn" class="play-pause-btn" aria-label="Play/Pause">
            <svg id="icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M8 5v14l11-7z"/></svg>
            <svg id="icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </button>
          <!-- Canvas layer (hidden for now) -->
          <canvas id="replay-canvas" style="display:none;"></canvas>
          <!-- Divider (hidden for now) -->
          <div id="split-divider" class="split-divider" style="display:none;">
            <div class="split-handle"></div>
          </div>
          <!-- Side labels (hidden for now) -->
          <!--
          <div class="absolute top-3 left-4 z-10 text-[9px] font-bold uppercase tracking-wider text-[var(--color-text-primary)] bg-[var(--color-surface)]/80 backdrop-blur-sm px-2 py-0.5 rounded">Real</div>
          <div class="absolute top-3 right-4 z-10 text-[9px] font-bold uppercase tracking-wider text-[var(--color-text-primary)] bg-[var(--color-surface)]/80 backdrop-blur-sm px-2 py-0.5 rounded">Sim</div>
          -->
          <!-- Status overlay -->
          <div id="replay-status" class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 text-xs font-bold px-4 py-1.5 bg-[var(--color-surface)]/90 backdrop-blur-sm rounded-full border border-[var(--color-border)] text-[var(--color-text-primary)]"></div>
        </div>
      </div>

      <!-- Learning controllers (right) -->
      <div class="flex flex-row flex-wrap md:flex-col md:flex-nowrap justify-center gap-2 min-w-[100px]" id="tabs-right">
        <span class="w-full text-[9px] uppercase tracking-[0.15em] font-bold text-[var(--color-text-muted)] text-center mb-3 border-b border-[var(--color-border)] pb-2">Learning</span>
        <button data-ctrl="PPO" class="ctrl-tab relative">PPO<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">0.6ms</span></button>
        <button data-ctrl="TD3" class="ctrl-tab relative">TD3<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded">7.9ms</span></button>
        <button data-ctrl="TQC" class="ctrl-tab relative">TQC<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded">7.9ms</span></button>
        <button data-ctrl="SAC" class="ctrl-tab relative">SAC<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded">7.8ms</span></button>
        <button data-ctrl="TRPO" class="ctrl-tab relative">TRPO<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">0.7ms</span></button>
      </div>
    </div>

    <!-- MPPI (LSTM): bottom row, centered -->
    <div class="flex flex-col items-center gap-2 mt-6">
      <div class="flex flex-wrap justify-center gap-3">
        <button data-ctrl="MPPI" class="ctrl-tab relative">MPPI (WM)<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded">~40ms</span></button>
        <button data-ctrl="PPO_WM" class="ctrl-tab relative">PPO (WM)<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">6.7ms</span></button>
        <button data-ctrl="IQL" class="ctrl-tab relative">IQL (OffRL)<span class="absolute -top-1.5 -right-1.5 text-[8px] font-bold text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-1 rounded normal-case">2.0ms</span></button>
      </div>
      <span class="text-[9px] uppercase tracking-[0.15em] font-bold text-[var(--color-text-muted)] border-t border-[var(--color-border)] pt-2 w-full text-center">Data-Driven</span>
    </div>
  </div>
</section>

<style>
  .ctrl-tab {
    padding: 0.5rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 2px solid var(--color-border);
    text-align: center;
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.1s ease;
  }
  .ctrl-tab:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-border-strong);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px 0px var(--color-border-strong);
  }
  .ctrl-tab.active {
    background: var(--color-accent);
    border-color: var(--color-border-strong);
    color: #111;
    box-shadow: 3px 3px 0px 0px var(--color-border-strong);
    transform: translate(-1px, -1px);
  }
  .cat-btn {
    padding: 0.375rem 1rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.1s ease;
  }
  .cat-btn:hover:not(:disabled) {
    border-color: var(--color-border-strong);
    background: var(--color-surface-alt);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px 0px var(--color-border-strong);
  }
  .cat-btn.disabled, .cat-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  .cat-btn.active {
    background: var(--color-success);
    color: #111;
    border-color: var(--color-border-strong);
    box-shadow: 3px 3px 0px 0px var(--color-border-strong);
    transform: translate(-1px, -1px);
  }

  /* Play/pause overlay */
  .play-pause-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 15;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .play-pause-btn:hover,
  .play-pause-btn.paused {
    opacity: 1;
  }
  .play-pause-btn svg {
    width: 52px;
    height: 52px;
    color: white;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.6));
    background: rgba(0,0,0,0.45);
    border-radius: 50%;
    padding: 10px;
  }

  /* Split divider / comparison slider */
  .split-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 24px;
    margin-left: -12px;
    cursor: ew-resize;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .split-divider::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    background: var(--color-text-primary);
    opacity: 0.2;
  }
  .split-handle {
    position: relative;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    transition: transform 0.15s ease, opacity 0.15s ease;
    opacity: 0.7;
  }
  .split-handle::before,
  .split-handle::after {
    content: '';
    width: 0;
    height: 0;
    border-style: solid;
  }
  .split-handle::before {
    border-width: 3px 4px 3px 0;
    border-color: transparent var(--color-surface) transparent transparent;
  }
  .split-handle::after {
    border-width: 3px 0 3px 4px;
    border-color: transparent transparent transparent var(--color-surface);
  }
  .split-divider:hover .split-handle {
    transform: scale(1.15);
    opacity: 1;
  }
</style>

<script>
  // --- Video-only mode (sim/slider disabled for now) ---
  const BASE_URL = import.meta.env.BASE_URL || '/';

  // --- State ---
  let trialData: any = null;
  let currentCtrl = 'PID';
  let currentCat = 'fast_settle';

  // --- DOM ---
  const videoEl    = document.getElementById('replay-video') as HTMLVideoElement;
  const statusEl   = document.getElementById('replay-status')!;
  const ppBtn      = document.getElementById('play-pause-btn')!;
  const iconPlay   = document.getElementById('icon-play') as SVGElement;
  const iconPause  = document.getElementById('icon-pause') as SVGElement;

  // --- Play/pause toggle ---
  function syncPlayPauseIcon() {
    const paused = videoEl.paused;
    iconPlay.style.display  = paused ? '' : 'none';
    iconPause.style.display = paused ? 'none' : '';
    ppBtn.classList.toggle('paused', paused);
  }
  videoEl.addEventListener('play',  syncPlayPauseIcon);
  videoEl.addEventListener('pause', syncPlayPauseIcon);
  ppBtn.addEventListener('click', () => {
    if (videoEl.paused) videoEl.play().catch(() => {});
    else videoEl.pause();
  });
  videoEl.addEventListener('click', () => {
    if (videoEl.paused) videoEl.play().catch(() => {});
    else videoEl.pause();
  });;

  // --- Video loading ---
  function loadVideo(ctrl: string, cat: string) {
    const videoPath = BASE_URL + 'videos/' + ctrl + '/' + cat + '.mp4';
    statusEl.textContent = '';
    videoEl.pause();
    videoEl.src = videoPath;
    videoEl.load();
    videoEl.onerror = () => { statusEl.textContent = 'No video available'; };
    // If already ready (cached), play now; otherwise wait for canplay
    if (videoEl.readyState >= 3) {
      videoEl.play().catch(() => {});
    } else {
      videoEl.addEventListener('canplay', function onReady() {
        videoEl.removeEventListener('canplay', onReady);
        videoEl.play().catch(() => {});
      });
    }
  }

  // --- Status from trial data ---
  function updateStatusFromTrial() {
    if (videoOnlyCats[currentCtrl]) { statusEl.textContent = ''; return; }
    if (!trialData) return;
    const ctrl = trialData[currentCtrl];
    if (!ctrl) { statusEl.textContent = 'No data'; return; }
    const trial = ctrl[currentCat] || ctrl[Object.keys(ctrl)[0]];
    if (!trial) { statusEl.textContent = 'No data'; return; }
    // Status shown after video ends via 'ended' event
  }

  // --- Video ended: show result ---
  videoEl.addEventListener('ended', () => {
    if (!trialData) return;
    const ctrl = trialData[currentCtrl];
    if (!ctrl) return;
    const trial = ctrl[currentCat] || ctrl[Object.keys(ctrl)[0]];
    if (!trial) return;
    if (trial.success && trial.settling_time != null) {
      statusEl.textContent = 'Settled ' + trial.settling_time.toFixed(2) + 's';
    } else {
      statusEl.textContent = 'Failed';
    }
    // Restart after pause
    setTimeout(() => {
      statusEl.textContent = '';
      videoEl.currentTime = 0;
      videoEl.play().catch(() => {});
    }, 2500);
  });

  // --- Data loading ---
  async function loadData() {
    try {
      const resp = await fetch(BASE_URL + 'data/controller_trials.json');
      if (!resp.ok) { console.error('Failed to load trial data:', resp.status); return; }
      trialData = await resp.json();
      onTrialChange();
    } catch (e) {
      console.error('Failed to load trial data:', e);
    }
  }

  // --- Controllers that have videos but no trial data entry ---
  const videoOnlyCats: Record<string, string[]> = {
    'MPPI': ['fast_settle', 'recovery'],
    'PPO_WM': ['fast_settle', 'recovery'],
    'IQL': ['fast_settle', 'recovery'],
  };

  // --- Available categories per controller (derived from data or video-only map) ---
  function getAvailableCats(ctrl: string): string[] {
    if (videoOnlyCats[ctrl]) return videoOnlyCats[ctrl];
    if (!trialData) return [];
    const d = trialData[ctrl];
    if (!d) return [];
    return Object.keys(d);
  }

  function updateCatButtons() {
    const available = getAvailableCats(currentCtrl);
    document.querySelectorAll('.cat-btn').forEach(btn => {
      const cat = (btn as HTMLElement).dataset.cat!;
      const has = available.includes(cat);
      btn.classList.toggle('disabled', !has);
      (btn as HTMLButtonElement).disabled = !has;
      if (!has && cat === currentCat) {
        // Switch to first available
        if (available.length > 0) {
          currentCat = available[0];
          document.querySelectorAll('.cat-btn').forEach(b => {
            b.classList.toggle('active', (b as HTMLElement).dataset.cat === currentCat);
          });
        }
      }
    });
  }

  // --- UI updates ---
  function onTrialChange() {
    updateCatButtons();
    loadVideo(currentCtrl, currentCat);
    updateStatusFromTrial();
  }

  // --- Controller & category selection ---
  document.querySelectorAll('.ctrl-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      currentCtrl = (btn as HTMLElement).dataset.ctrl!;
      document.querySelectorAll('.ctrl-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      onTrialChange();
    });
  });

  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if ((btn as HTMLButtonElement).disabled) return;
      currentCat = (btn as HTMLElement).dataset.cat!;
      document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      onTrialChange();
    });
  });

  // --- Init ---
  function init() {
    loadData();
  }
  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
</script>
