<script is:inline>
  // Sidebar active tracking: scroll-position based
  document.addEventListener('DOMContentLoaded', () => {
    const links = document.querySelectorAll('.docs-sidebar .docs-link');
    const sections = Array.from(document.querySelectorAll('.docs-section'));
    function updateActive() {
      let current = sections[0];
      const offset = 100;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= offset) {
          current = section;
        } else {
          break;
        }
      }
      links.forEach(l => l.classList.remove('is-active'));
      const id = current.id;
      const link = document.querySelector('.docs-sidebar a[href="#' + id + '"]');
      if (link) link.classList.add('is-active');
    }
    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  });
</script>

<!-- Three.js STL viewer (importmap is in Layout.astro head) -->
<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
  window.__BASE_URL__ = baseUrl;
</script>
<script type="module" is:inline>
  import * as THREE from 'three';
  import { STLLoader } from 'three/addons/loaders/STLLoader.js';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

  const canvases = document.querySelectorAll('.stl-viewer');
  if (canvases.length) {
    const isDark = document.documentElement.classList.contains('dark');
    const bgColor = isDark ? 0x232323 : 0xeeece4;

    canvases.forEach(canvas => {
      const stlFile = canvas.dataset.stl;
      const w = canvas.clientWidth || 300;
      const h = canvas.clientHeight || 144;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(bgColor);

      const camera = new THREE.PerspectiveCamera(40, w / h, 0.1, 2000);
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setSize(w, h);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      scene.add(new THREE.AmbientLight(0xffffff, 0.7));
      const dir = new THREE.DirectionalLight(0xffffff, 1.0);
      dir.position.set(50, 80, 50);
      scene.add(dir);

      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 1.2;

      const base = window.__BASE_URL__ || '/';
      // Join with exactly one slash: stlFile is an absolute "/assets/..." path,
      // so a naive base + stlFile ("/" + "/assets/...") yields "//assets/..." —
      // a protocol-relative URL the browser resolves to https://assets/... (CORS fail).
      const stlUrl = base.replace(/\/+$/, '') + '/' + stlFile.replace(/^\/+/, '');
      new STLLoader().load(stlUrl, (geo) => {
        const mat = new THREE.MeshStandardMaterial({ color: 0xcccccc, metalness: 0.2, roughness: 0.7 });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.rotation.x = -Math.PI / 2;
        geo.computeBoundingBox();
        const center = geo.boundingBox.getCenter(new THREE.Vector3());
        const size = geo.boundingBox.getSize(new THREE.Vector3());
        mesh.position.set(-center.x, -center.z, -center.y);
        const maxDim = Math.max(size.x, size.y, size.z) * parseFloat(canvas.dataset.zoom || '1');
        camera.position.set(maxDim * 0.575, maxDim * 0.425, maxDim * 1.0);
        camera.lookAt(0, 0, 0);
        controls.target.set(0, 0, 0);
        controls.update();
        scene.add(mesh);
      });

      (function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
      })();
    });
  }
</script>
