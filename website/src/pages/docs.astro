---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const REPO = 'https://github.com/JDRanpariya/ball-balancing-on-arc/blob/main';
const src = (path: string) => `${REPO}/${path}`;

const stlParts = [
  { name: 'Arc (Cart Mount)', file: '/assets/cart_3d_print.stl', desc: '3D-printed arc with Gaussian dip profile at center. Mounts directly on linear cart.' },
  { name: 'Arduino Mount', file: '/assets/arduino-mount.stl', desc: 'Bracket for the Arduino Uno sensor board.', zoom: 1.35 },
];

import katex from 'katex';
const renderEq = (tex: string) => katex.renderToString(tex, { displayMode: true, throwOnError: false });

const eq_main = renderEq(`\\ddot{\\theta} = \\frac{-R\\cos\\theta \\, \\ddot{x} - \\tfrac{1}{2}C_{\\text{eff}}'\\dot{\\theta}^2 - g(-R\\sin\\theta + \\alpha) - Q_{\\text{fric}}}{C_{\\text{eff}}(\\theta)}`);
const eq_ceff = renderEq(`C_{\\text{eff}}(\\theta) = R^2 - 2R\\alpha\\sin\\theta + \\alpha^2 + \\frac{I_{\\text{ball}}}{m}\\left(\\frac{R}{r}\\right)^2`);
const eq_alpha = renderEq(`\\alpha(\\theta) = 2dk\\theta \\, e^{-k\\theta^2}, \\quad k = \\frac{R^2}{2\\sigma^2}`);
const eq_fric = renderEq(`Q_{\\text{fric}} = \\mu_{\\text{roll}} \\, gR\\cos\\theta \\, \\tanh\\!\\left(\\frac{\\dot{\\theta}}{\\epsilon}\\right) + \\mu_{\\text{visc}} \\dot{\\theta}`);
const eq_motor = renderEq(`\\text{Motor: } \\dot{x} = v_{\\text{cmd}} + (\\dot{x} - v_{\\text{cmd}})\\,e^{-\\Delta t / \\tau_v}`);
---

<Layout title="Docs - Ball-on-Arc Benchmark">
  <!-- Simple header for docs (not fixed nav) -->
  <header class="border-b border-[var(--color-border)] px-4 py-4">
    <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-y-2">
      <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-2 text-sm font-semibold text-[var(--color-text-primary)] hover:opacity-70 transition-opacity">
        <span class="text-[var(--color-accent-text)]">&#9679;</span> Ball-on-Arc
        <span class="text-[var(--color-text-muted)] font-normal">/ docs</span>
      </a>
      <nav class="flex items-center gap-5 text-xs text-[var(--color-text-secondary)]" aria-label="Docs navigation">
        <a href={`${import.meta.env.BASE_URL}`} class="hover:text-[var(--color-text-primary)] transition-colors">Home</a>
        <a href="/docs" class="text-[var(--color-text-primary)] font-semibold" aria-current="page">Docs</a>
        <a href="https://github.com/JDRanpariya/ball-balancing-on-arc" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text-primary)] transition-colors">Repository</a>
      </nav>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-4 flex">
    <!-- Sidebar -->
    <aside class="hidden lg:block w-40 shrink-0 sticky top-4 self-start pt-10 pr-6">
      <nav class="docs-sidebar flex flex-col gap-1.5 text-xs text-[var(--color-text-secondary)]" aria-label="Documentation sections">
        <a href="#overview" class="docs-link is-active">Overview</a>
        <a href="#hardware" class="docs-link">Hardware</a>
        <a href="#environment" class="docs-link">Environment</a>
        <a href="#training" class="docs-link">Training</a>
        <a href="#experiments" class="docs-link">Experiments</a>
        <a href="#reproduce" class="docs-link">Reproduce</a>
        <a href="#controllers" class="docs-link">Controllers</a>
        <a href="#datasets" class="docs-link">Datasets</a>
      </nav>
    </aside>

    <!-- Content -->
    <main class="flex-1 min-w-0 py-10 lg:pl-8 max-w-3xl" id="main-content">

      <!-- Overview -->
      <section id="overview" class="docs-section pb-12 mb-12 border-b border-[var(--color-border)]">
        <h1 class="text-2xl md:text-4xl font-bold tracking-tight leading-tight mb-4">
          Documentation
        </h1>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-xl mb-6">
          Everything you need to reproduce the ball-on-arc benchmark: hardware specs, simulation environment, training pipeline, evaluation protocols, 3D-printable parts, and the open dataset.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
          <div class="p-3 border border-[var(--color-border)] bg-[var(--color-surface-alt)]">
            <div class="text-xl font-bold">13</div>
            <div class="text-[10px] text-[var(--color-text-muted)]">Controllers</div>
          </div>
          <div class="p-3 border border-[var(--color-border)] bg-[var(--color-surface-alt)]">
            <div class="text-xl font-bold">2</div>
            <div class="text-[10px] text-[var(--color-text-muted)]">Experiments</div>
          </div>
          <div class="p-3 border border-[var(--color-border)] bg-[var(--color-surface-alt)]">
            <div class="text-xl font-bold">1M</div>
            <div class="text-[10px] text-[var(--color-text-muted)]">Calibrated Transitions</div>
          </div>
          <div class="p-3 border border-[var(--color-border)] bg-[var(--color-surface-alt)]">
            <div class="text-xl font-bold">20Hz</div>
            <div class="text-[10px] text-[var(--color-text-muted)]">Control Rate</div>
          </div>
        </div>
      </section>

      <!-- Hardware -->
      <section id="hardware" class="docs-section pb-12 mb-12 border-b border-[var(--color-border)]">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-2">Hardware</p>
        <h2 class="text-xl font-bold tracking-tight mb-6">Bill of Materials</h2>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Control &amp; Drive (Beckhoff)</h3>
        <div class="overflow-x-auto mb-6">
          <table class="docs-table">
            <thead><tr><th>Part</th><th>Description</th><th>Role</th></tr></thead>
            <tbody>
              <tr><td>C6015-0010</td><td>Ultra-compact IPC (Atom E3845, 4-core)</td><td>TwinCAT 3 runtime</td></tr>
              <tr><td>EK1100</td><td>EtherCAT Coupler</td><td>Terminal stack head</td></tr>
              <tr><td>EL7201-0010</td><td>Servo Terminal (OCT, 48V, 2.8A rms)</td><td>Drives AM8121</td></tr>
              <tr><td>EL9576</td><td>Brake Chopper Terminal</td><td>Regen energy dissipation</td></tr>
              <tr><td>ZB8110</td><td>Braking Resistor (100W, 10&Omega;)</td><td>EL9576 accessory</td></tr>
              <tr><td>EL6002</td><td>2-port RS-232 Serial Terminal</td><td>Host PC comms (ch 2)</td></tr>
              <tr><td>EL1859</td><td>8 DI + 8 DO combo</td><td>Limit switches, status</td></tr>
              <tr><td>AM8121-0FH0</td><td>Servo Motor (0.50 Nm, OCT)</td><td>Cart actuation</td></tr>
              <tr><td>PS2001-2410</td><td>24V DC PSU (10A / 240W)</td><td>Powers terminal stack</td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Actuator &amp; Sensors</h3>
        <div class="overflow-x-auto mb-6">
          <table class="docs-table">
            <thead><tr><th>Part</th><th>Description</th><th>Notes</th></tr></thead>
            <tbody>
              <tr><td>LEFB32NXS-1000</td><td>SMC Linear Actuator (1000mm stroke)</td><td>Belt-driven, cart rides on this</td></tr>
              <tr><td>VL53L0X &times; 2</td><td>Time-of-Flight distance sensor</td><td>I&sup2;C, one per arc edge, 34.5ms timing budget</td></tr>
              <tr><td>Adafruit #2167</td><td>IR Beam Break (508 thru-beam)</td><td>Ball-at-center detection</td></tr>
              <tr><td>Arduino Uno</td><td>Sensor acquisition MCU</td><td>Reads ToF + IR, USB to host</td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Cables &amp; 3D Parts</h3>
        <div class="overflow-x-auto mb-6">
          <table class="docs-table">
            <thead><tr><th>Item</th><th>Qty</th><th>Notes</th></tr></thead>
            <tbody>
              <tr><td>OCT motor cable (ZK4000-series)</td><td>1</td><td>Power + encoder, AM8121 &rarr; EL7201</td></tr>
              <tr><td>EtherCAT patch (RJ-45, CAT5e+)</td><td>1</td><td>C6015 &rarr; EK1100</td></tr>
              <tr><td>USB-to-RS232 adapter (FTDI/CH340)</td><td>1</td><td>Host &harr; EL6002 X2</td></tr>
              <tr><td>USB-A to USB-B</td><td>1</td><td>Host &harr; Arduino</td></tr>
              <tr><td>3D-printed arc (PLA, 0.2mm, 30%)</td><td>1</td><td>R=2.101m, Gaussian dip</td></tr>
              <tr><td>3D-printed Arduino mount (PLA)</td><td>1</td><td>Holds the Arduino Uno on the rig frame</td></tr>
              <tr><td>Acrylic sheets (320&times;90mm)</td><td>2</td><td>Side walls for ball containment</td></tr>
              <tr><td><strong>Steel ball</strong> (24&thinsp;g, 9&thinsp;mm radius / 18&thinsp;mm &Oslash;)</td><td>1</td><td>Standard bearing ball; matches <code>BALL_MASS_KG=0.024</code>, <code>BALL_RADIUS_M=0.009</code></td></tr>
            </tbody>
          </table>
        </div>

        <p class="text-xs text-[var(--color-text-muted)]">
          Physical constants in <a href={src('balancer/balancer/core/params.py')} target="_blank" rel="noopener noreferrer" class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)] hover:border-[var(--color-accent-text)] text-[var(--color-accent-text)] hover:underline rounded-sm">balancer/core/params.py</a> &middot; Serial config in <a href={src('balancer/balancer/hardware/serial_config.py')} target="_blank" rel="noopener noreferrer" class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)] hover:border-[var(--color-accent-text)] text-[var(--color-accent-text)] hover:underline rounded-sm">balancer/hardware/serial_config.py</a>
          &middot; <a href="https://github.com/JDRanpariya/ball-balancing-on-arc/blob/main/hardware/BOM_AND_ASSEMBLY.md" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-text)] hover:underline">Full BOM and Assembly &nearr;</a>
        </p>

        <h3 id="parts" class="text-xs font-bold uppercase tracking-wide mb-3 mt-8">3D-Printable Parts</h3>
        <p class="text-xs text-[var(--color-text-muted)] mb-4">The arc and the Arduino mount are the custom 3D-printed components. Drag to orbit, scroll to zoom.</p>
        <div class="grid sm:grid-cols-2 gap-4 max-w-3xl" id="stl-grid">
          {stlParts.map((part) => (
            <div class="border border-[var(--color-border)] bg-[var(--color-surface-alt)] overflow-hidden">
              <canvas
                class="stl-viewer w-full h-48 cursor-grab active:cursor-grabbing"
                data-stl={part.file}
                data-zoom={part.zoom || 1}
                aria-label={part.name + ' - 3D interactive viewer'}
              ></canvas>
              <div class="p-4 border-t border-[var(--color-border)]">
                <div class="text-sm font-semibold">{part.name}</div>
                <p class="text-xs text-[var(--color-text-muted)] mt-1">{part.desc}</p>
                <div class="flex items-center gap-4 mt-3">
                  <a
                    href={part.file}
                    download
                    class="text-[11px] font-semibold text-[var(--color-accent-text)] hover:underline"
                  >
                    &darr; Download STL
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Simulation -->
      <section id="environment" class="docs-section pb-12 mb-12 border-b border-[var(--color-border)]">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-2">Environment</p>
        <h2 class="text-xl font-bold tracking-tight mb-4">Gymnasium Environment</h2>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
          The simulation is a Gymnasium-compatible environment implementing the full nonlinear dynamics of the ball-on-arc system including Coulomb/viscous friction, motor first-order lag, and a Gaussian dip profile.
        </p>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Key Features</h3>
        <ul class="space-y-2 text-sm text-[var(--color-text-secondary)] mb-6">
          <li>&bull; <strong>RK4 integration</strong> with configurable substeps (default 10/step)</li>
          <li>&bull; <strong>Domain randomization:</strong> randomizes friction, motor lag, arc radius, ball mass at episode reset</li>
          <li>&bull; <strong>Blind-zone modeling:</strong> masks ball observation when outside sensor FoV (matches hardware &plusmn;90mm limit)</li>
          <li>&bull; <strong>Observation noise:</strong> Gaussian noise on ball position (&sigma;&asymp;1.7mm training-time value; the deployed board measures &sigma;&asymp;3.3mm)</li>
          <li>&bull; <strong>Action space:</strong> continuous velocity command &in; [-1, 1] (scaled to &plusmn;0.9 m/s)</li>
          <li>&bull; <strong>Observation:</strong> [cart_pos, cart_vel, ball_angle, ball_angular_vel] (4D)</li>
        </ul>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Dynamics Model</h3>
        <div class="math-block mb-4 overflow-x-auto">
          <div class="mb-3" set:html={eq_main}></div>
          <div class="space-y-2 mt-3">
            <div set:html={eq_ceff}></div>
            <div set:html={eq_alpha}></div>
            <div set:html={eq_fric}></div>
            <div set:html={eq_motor}></div>
          </div>
        </div>

        <p class="text-xs text-[var(--color-text-muted)]">
          Source: <a href={src('balancer/balancer/core/dynamics.py')} target="_blank" rel="noopener noreferrer" class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)] hover:border-[var(--color-accent-text)] text-[var(--color-accent-text)] hover:underline rounded-sm">balancer/core/dynamics.py</a> &middot; Env: <a href={src('balancer/balancer/envs/sim.py')} target="_blank" rel="noopener noreferrer" class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)] hover:border-[var(--color-accent-text)] text-[var(--color-accent-text)] hover:underline rounded-sm">balancer/envs/sim.py</a>
        </p>
      </section>

      <!-- Training -->
      <section id="training" class="docs-section pb-12 mb-12 border-b border-[var(--color-border)]">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-2">Training</p>
        <h2 class="text-xl font-bold tracking-tight mb-4">RL Training Pipeline</h2>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
          Built on Stable-Baselines3 + Hydra for config management + Weights and Biases for experiment tracking. All RL training runs on CPU (Appendix VI: CPU is faster than GPU for networks this small).
        </p>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Supported Algorithms</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-6">
          <div class="px-3 py-2 border border-[var(--color-border)] text-xs font-medium">PPO</div>
          <div class="px-3 py-2 border border-[var(--color-border)] text-xs font-medium">SAC</div>
          <div class="px-3 py-2 border border-[var(--color-border)] text-xs font-medium">TD3</div>
          <div class="px-3 py-2 border border-[var(--color-border)] text-xs font-medium">TQC</div>
          <div class="px-3 py-2 border border-[var(--color-border)] text-xs font-medium">TRPO</div>
          <div class="px-3 py-2 border border-[var(--color-border)] text-xs text-[var(--color-text-muted)]">+ IQL, MPPI, PPO-WM</div>
        </div>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Key Training Details</h3>
        <ul class="space-y-2 text-sm text-[var(--color-text-secondary)] mb-6">
          <li>&bull; <strong>Vectorized envs:</strong> 16 parallel environments (DummyVecEnv)</li>
          <li>&bull; <strong>Timesteps:</strong> 3M total (PPO ~40 min on CPU; see Appendix V, Table 8 for full times)</li>
          <li>&bull; <strong>Domain randomization</strong> (<code>--dr</code>): friction &plusmn;30%, motor lag &plusmn;50%, mass &plusmn;20% per episode via <code>env.fixed_param=False</code></li>
          <li>&bull; <strong>Blind zone</strong> (<code>--blind-zone</code>): <code>env.sensor_blind_zone=True</code>; clamps ball observation near arc edges (matches VL53L0X min-range saturation, θ &asymp; 0.071&nbsp;rad)</li>
          <li>&bull; <strong>Reward</strong> (<code>balanced</code>): dual-Gaussian position + velocity gate + cart-wall penalty + boundary penalty + effort/jerk penalties</li>
          <li>&bull; <strong>Checkpointing:</strong> best model saved by eval callback every 50k steps</li>
        </ul>

        <pre class="code-block"><code># Train PPO with domain randomization + blind zone (the BZ+DR configuration)
cd training
python scripts/train_all_cont.py \
  --algos ppo --rewards balanced --dr --blind-zone \
  --timesteps 3000000 --tag ppo_balanced_dr_bz</code></pre>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3 mt-6">Training Times (CPU, Appendix V, Table 8)</h3>
        <div class="overflow-x-auto mb-4">
          <table class="docs-table">
            <thead><tr><th>Algorithm</th><th>Time (CPU)</th></tr></thead>
            <tbody>
              <tr><td>PPO</td><td>~40 min</td></tr>
              <tr><td>TRPO</td><td>~58 min</td></tr>
              <tr><td>SAC / TD3</td><td>~5.7 h</td></tr>
              <tr><td>TQC</td><td>~8.5 h</td></tr>
            </tbody>
          </table>
        </div>

        <p class="text-xs text-[var(--color-text-muted)] mt-3">
          Source: <a href={src('training/scripts/train.py')} target="_blank" rel="noopener noreferrer" class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)] hover:border-[var(--color-accent-text)] text-[var(--color-accent-text)] hover:underline rounded-sm">training/scripts/train.py</a> &middot; Configs: <a href={src('training/configs/train.yaml')} target="_blank" rel="noopener noreferrer" class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)] hover:border-[var(--color-accent-text)] text-[var(--color-accent-text)] hover:underline rounded-sm">training/configs/</a>
          &middot; <a href="https://github.com/JDRanpariya/ball-balancing-on-arc/blob/main/training/README.md" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-text)] hover:underline">Training README &nearr;</a>
        </p>
      </section>

      <!-- Experiments -->
      <section id="experiments" class="docs-section pb-12 mb-12 border-b border-[var(--color-border)]">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-2">Experiments</p>
        <h2 class="text-xl font-bold tracking-tight mb-4">Experimental Protocols</h2>

        <div class="space-y-6 mb-6">
          <div class="border-l-4 border-[var(--color-accent)] pl-4">
            <h3 class="text-sm font-bold">Experiment 1: Baseline Performance</h3>
            <p class="text-xs text-[var(--color-text-secondary)] mt-1">
              50 hardware trials per controller with difficulty-stratified initial <strong>cart</strong> positions
              (cart in [±0.10, ±0.40, ±0.65, ±0.7765&nbsp;m]; ball angle arising from the cart jolt is <em>uncontrolled</em>, θ<sub>0</sub> &isin; [&minus;4.8°, 4.3°]).
              Success = ball within <strong>&plusmn;0.01&nbsp;rad</strong> (&plusmn;21&nbsp;mm of arc displacement) held for 1.0&nbsp;s continuous, within a <strong>30&nbsp;s</strong> trial timeout.
            </p>
          </div>
          <div class="border-l-4 border-[var(--color-accent)] pl-4">
            <h3 class="text-sm font-bold">Frequency Robustness (Exp 3 in code)</h3>
            <p class="text-xs text-[var(--color-text-secondary)] mt-1">
              Control frequency swept 5 / 10 / 20 / 50 Hz. Tests graceful degradation under computational budget constraints. 50 simulation trials per frequency per controller.
            </p>
          </div>
        </div>

        <h3 class="text-xs font-bold uppercase tracking-wide mb-3">Metrics</h3>
        <ul class="space-y-1 text-sm text-[var(--color-text-secondary)] mb-6">
          <li>&bull; <strong>Success Rate (SR):</strong> % of trials achieving settling criterion</li>
          <li>&bull; <strong>Settling Time:</strong> time from start to first continuous 1s in band</li>
          <li>&bull; <strong>Median Settling:</strong> median settling time across successful trials</li>
        </ul>

        <pre class="code-block"><code># Sim evaluation (Exp 1 = baseline benchmark; Exp 3 = frequency robustness)
python scripts/eval_sim.py --exp 1 --action-type cont

# Hardware evaluation (Exp 1, stratified 50 trials)
python scripts/eval.py --exp 1 --action-type cont --trials 50</code></pre>

        <p class="text-xs text-[var(--color-text-muted)] mt-3">
          Source: <code class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)]">evaluation/scripts/</code> &middot; CMA-ES tuner: <code class="text-[11px] px-1 py-0.5 bg-[var(--color-surface-alt)] border border-[var(--color-border)]">evaluation/tuning/</code>
          &middot; <a href="https://github.com/JDRanpariya/ball-balancing-on-arc/blob/main/evaluation/README.md" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-text)] hover:underline">Evaluation README &nearr;</a>
        </p>
      </section>



      <!-- Reproduce -->
      <section id="reproduce" class="docs-section pb-12 mb-12 border-b border-[var(--color-border)]">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-accent-text)] mb-2">Reproduce</p>
        <h2 class="text-xl font-bold tracking-tight mb-4">Reproduce the Results</h2>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-6">
          The guide breaks reproduction into 8 stages; the cards below summarize the key ones. Each card below gives the goal and the key command; click through for the full details.
          The canonical end-to-end reference is the
          <a href="https://github.com/JDRanpariya/ball-balancing-on-arc/blob/main/reproducibility_guide.md" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent-text)] hover:underline">Reproducibility Guide &nearr;</a>.
        </p>

        <div class="repro-steps">
          <!-- Stage 1 -->
          <div class="repro-card">
            <div class="repro-card-head">
              <span class="repro-step-num">1</span>
              <span class="repro-step-label">Environment Setup</span>
            </div>
            <div class="repro-card-body">
              <p class="repro-card-goal">Clone the repository and install all Python dependencies in a single conda environment.</p>
              <pre class="code-block"><code>git clone https://github.com/JDRanpariya/ball-balancing-on-arc.git
cd ball-balancing-on-arc
git lfs pull
conda env create -f env.yaml && conda activate balancer
make install-full    # installs the balancer package (+ RL/MPC extras)
make check           # verify 1,050 trials (21 configs x 50) present</code></pre>
              <div class="repro-links">
                <a href="https://github.com/JDRanpariya/ball-balancing-on-arc/blob/main/reproducibility_guide.md" target="_blank" rel="noopener noreferrer">Full instructions &nearr;</a>
